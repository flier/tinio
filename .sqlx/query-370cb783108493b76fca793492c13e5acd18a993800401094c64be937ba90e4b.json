  "db_name": "PostgreSQL",
  "query": "SELECT\n    p.number,\n    p.etag,\n    c.algorithm AS \"algorithm?: checksum::Algorithm\",\n    c.value AS \"value?\"\nFROM parts p\nLEFT JOIN part_checksums c\n    ON c.bucket = p.bucket AND c.upload_id = p.upload_id AND c.number = p.number\nWHERE p.bucket = $1 AND p.upload_id = $2 AND p.number >= $3\nORDER BY p.number\nLIMIT $4\n",
