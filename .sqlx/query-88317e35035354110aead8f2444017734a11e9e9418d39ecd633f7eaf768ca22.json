  "query": "SELECT p.number, p.etag, c.algorithm AS \"algorithm?: checksum::Algorithm\", c.value AS \"value?\"\n    FROM parts p\n    LEFT JOIN part_checksums c\n        ON c.bucket = p.bucket AND c.upload_id = p.upload_id AND c.number = p.number\n    WHERE p.bucket = $1 AND p.upload_id = $2 AND p.number = ANY($3)\n",
