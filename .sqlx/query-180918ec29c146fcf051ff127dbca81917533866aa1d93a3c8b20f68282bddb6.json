  "query": "SELECT\n    u.upload_id,\n    u.key,\n    u.initiated_at,\n    u.tags AS \"tags: object::Tags\",\n    u.acl AS \"acl: Acl\",\n    c.algorithm AS \"algorithm?\",\n    c.kind AS \"kind?\"\nFROM uploads u LEFT JOIN upload_checksums c\n    ON c.bucket = u.bucket AND c.upload_id = u.upload_id\nWHERE u.bucket = $1 AND u.upload_id = $2\n",
