  "query": "SELECT\n    r.bucket,\n    r.key,\n    r.seq,\n    r.blob\nFROM version_rows AS r\nWHERE\n    (r.bucket, r.key) > ($1::text COLLATE \"C\", $2::text COLLATE \"C\")\n    OR (\n        r.bucket = $1::text COLLATE \"C\"\n        AND r.key = $2::text COLLATE \"C\"\n        AND r.seq > $3::bigint\n    )\nORDER BY r.bucket COLLATE \"C\", r.key COLLATE \"C\", r.seq\nLIMIT $4\n",
