{
  "db_name": "PostgreSQL",
  "query": "SELECT l.mode, l.retain_until, l.legal_hold\nFROM version_object_lock AS l\nWHERE\n    l.bucket = $1\n    AND EXISTS (\n        SELECT 1\n        FROM version_lock_owned AS o\n        WHERE\n            o.bucket = l.bucket\n            AND o.key = l.key\n            AND o.version_id = l.version_id\n    )\nORDER BY l.key, l.version_id\nFOR UPDATE OF l\n",
